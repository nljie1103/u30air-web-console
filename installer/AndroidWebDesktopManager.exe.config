<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable WebView2 host only. Windows Explorer can attach Mark-of-the-Web
  to assemblies extracted from a downloaded ZIP. The .NET Framework may
  otherwise refuse to load the bundled Python.Runtime.dll in pythonnet.
  This is an application-local CLR setting; system-wide security policies
  and antivirus are unchanged.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
